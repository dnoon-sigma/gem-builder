# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only
SUPABASE_SERVICE_ROLE_KEY=
PARALLEL_API_KEY=
# Protects the cron/ingest route
CRON_SECRET=
# Spend guard for Parallel calls
PARALLEL_DAILY_CALL_CAP=50
PARALLEL_ENABLED=true
# Public URL of the deployed app (Parallel sends webhooks here)
APP_URL=
# From Parallel platform -> Settings -> Webhooks (whsec_...)
PARALLEL_WEBHOOK_SECRET=
# Optional: how often to check inside the 36h pre-game window (default 3h)
PARALLEL_FAST_FREQUENCY=3h
